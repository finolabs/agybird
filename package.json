{
  "name": "agybird",
  "version": "0.4.3",
  "description": "Delegate code work, image generation or editing, and general tasks to the official Google Antigravity CLI through an existing Gemini subscription.",
  "keywords": [
    "antigravity",
    "agy",
    "gemini",
    "delegation",
    "code-review",
    "agent-skills"
  ],
  "type": "module",
  "private": true,
  "files": [
    "SKILL.md",
    "scripts/agybird.mjs",
    "scripts/companion.mjs",
    "scripts/lib/",
    "prompts/",
    "schemas/",
    "commands/",
    "claude-agents/",
    "hooks/",
    "references/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "assets/",
    "agents/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:live": "node scripts/live-test.mjs",
    "check": "node scripts/check.mjs"
  },
  "license": "MIT"
}
